{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "tasks",
    "validation"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "acceptance_criteria",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
