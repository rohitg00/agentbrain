{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "decision",
    "evidence_checked",
    "next_action"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "INTAKE",
        "RESEARCH",
        "CHALLENGE",
        "DECIDE",
        "DESIGN",
        "PLAN",
        "BUILD",
        "VERIFY",
        "REVIEW",
        "SHIP",
        "LEARN"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "continue",
        "blocked",
        "needs-review",
        "ready-to-ship",
        "killed"
      ]
    },
    "evidence_checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
