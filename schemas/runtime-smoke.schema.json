{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Smoke",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "version",
    "python_executable",
    "writable_temp_dir_status",
    "git_fetch_result",
    "git_freshness_result",
    "git_worktree_status",
    "exact_command",
    "command_exit_status",
    "smoke_result",
    "transcript_path",
    "transcript_redaction_status",
    "sandbox_write_mode",
    "brain_command_mode",
    "selected_command",
    "loaded_skills",
    "adapter_path",
    "blocked_commands",
    "run_scope",
    "validation_commands",
    "capability_matrix",
    "write_fence",
    "evidence"
  ],
  "properties": {
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "python_executable": {
      "type": "string",
      "minLength": 1
    },
    "writable_temp_dir_status": {
      "enum": [
        "writable",
        "blocked",
        "not_checked"
      ]
    },
    "git_fetch_result": {
      "type": "string",
      "minLength": 1
    },
    "git_freshness_result": {
      "type": "string",
      "minLength": 1
    },
    "git_worktree_status": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(clean|dirty: [0-9]+ path\\(s\\) changed|unavailable: .+)$"
    },
    "exact_command": {
      "type": "string",
      "minLength": 1
    },
    "command_exit_status": {
      "type": "integer",
      "minimum": 0
    },
    "smoke_result": {
      "enum": [
        "pass",
        "blocked",
        "fail"
      ]
    },
    "transcript_path": {
      "type": "string",
      "minLength": 1
    },
    "transcript_redaction_status": {
      "enum": [
        "redacted",
        "no_sensitive_content",
        "not_captured",
        "blocked"
      ]
    },
    "sandbox_write_mode": {
      "enum": [
        "read_only",
        "workspace_write",
        "approval_gated",
        "unrestricted",
        "unknown"
      ]
    },
    "brain_command_mode": {
      "enum": [
        "native_commands",
        "markdown_specs",
        "mixed",
        "unknown"
      ]
    },
    "selected_command": {
      "type": "string",
      "pattern": "^(/brain-[a-z0-9-]+|unknown)$"
    },
    "loaded_skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "adapter_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(adapters/[a-z0-9-]+/README\\.md|unknown)$"
    },
    "blocked_commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run_scope": {
      "enum": [
        "read_only_smoke",
        "full_validation"
      ]
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_files",
        "write_files",
        "run_shell",
        "request_approvals",
        "network_access",
        "native_brain_commands",
        "schema_artifacts",
        "blocked_command_reporting"
      ],
      "properties": {
        "read_files": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "write_files": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "run_shell": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "request_approvals": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "network_access": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "native_brain_commands": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "schema_artifacts": {
          "enum": ["yes", "no", "unknown", "blocked"]
        },
        "blocked_command_reporting": {
          "enum": ["yes", "no", "unknown", "blocked"]
        }
      }
    },
    "write_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "disallowed_paths",
        "user_owned_files",
        "rollback_command",
        "approval_state"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disallowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "user_owned_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_command": {
          "type": "string",
          "minLength": 1
        },
        "approval_state": {
          "enum": [
            "approved",
            "not_required",
            "blocked",
            "unknown"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_scope": {
            "const": "full_validation"
          }
        },
        "required": [
          "run_scope"
        ]
      },
      "then": {
        "properties": {
          "transcript_path": {
            "not": {
              "const": "not_captured_stdout_only"
            }
          },
          "sandbox_write_mode": {
            "not": {
              "const": "read_only"
            }
          },
          "writable_temp_dir_status": {
            "const": "writable"
          },
          "transcript_redaction_status": {
            "enum": [
              "redacted",
              "no_sensitive_content"
            ]
          },
          "capability_matrix": {
            "properties": {
              "read_files": {
                "const": "yes"
              },
              "write_files": {
                "const": "yes"
              },
              "run_shell": {
                "const": "yes"
              },
              "schema_artifacts": {
                "const": "yes"
              }
            }
          }
        }
      }
    }
  ]
}
