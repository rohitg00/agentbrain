{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "decision"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "area",
          "finding",
          "recommendation"
        ],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "note"
            ]
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "enum": [
        "approve",
        "request_changes",
        "block"
      ]
    }
  }
}
