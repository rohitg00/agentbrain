{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assumption Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumptions"
  ],
  "properties": {
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence",
          "validation_path"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "validation_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
