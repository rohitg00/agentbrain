{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "target_user",
    "problem",
    "evidence",
    "success_metric",
    "non_goals",
    "open_questions"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_user": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "success_metric": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
